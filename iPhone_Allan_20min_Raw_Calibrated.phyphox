<?xml version='1.0' encoding='utf-8'?>
<phyphox version="1.19" locale="en">
  <title>iPhone Allan 20 min - Raw + Cal</title>
  <category>Gyroscope</category>
  <icon>AD</icon>
  <description>Twenty-minute stationary Allan-deviation comparison of concurrent raw (uncalibrated) and calibrated iPhone gyroscope streams. Separate log-log comparisons for X, Y and Z in deg/s. Five-second start countdown, then 1200 seconds of acquisition. After automatic stop, press Finalise plots and export All data. Requires the iOS beta supporting preferUncalibrated.</description>
  <link label="Allan deviation: NIST handbook">https://nvlpubs.nist.gov/nistpubs/Legacy/SP/nistspecialpublication1065.pdf</link>
  <data-containers>
    <container size="1" init="1200">duration</container>
    <container size="1" init="0">now</container>
    <container size="1" init="0">elapsedMinutes</container>
    <container size="1" init="1200">remaining</container>
    <container size="1" init="5">minimumBlocks</container>
    <container size="1" init="0">refreshRequest</container>
    <container size="1" init="0">refreshDone</container>
    <container size="16" init="0.1,0.2,0.5,1,2,3,5,7,10,15,20,30,45,60,90,120">tauTargets</container>
    <container size="0">workMeans</container>
    <container size="0">workComplete</container>
    <container size="0">workDiff</container>
