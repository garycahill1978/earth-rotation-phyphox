  </data-containers>
  <input>
    <sensor type="gyroscope" rate="100" rateStrategy="request" preferUncalibrated="true">
      <output component="x">ux</output>
      <output component="y">uy</output>
      <output component="z">uz</output>
      <output component="t">ut</output>
    </sensor>
    <sensor type="gyroscope" rate="100" rateStrategy="request" preferUncalibrated="false">
      <output component="x">cx</output>
      <output component="y">cy</output>
      <output component="z">cz</output>
      <output component="t">ct</output>
    </sensor>
  </input>
  <views>
    <view label="1. Record">
      <info label="20 MINUTE STATIONARY RUN" />
      <info label="Place the iPhone flat on a rigid surface and let it settle. Keep the same orientation throughout: no ABBA turns during this run. Keep phyphox open in the foreground." />
      <info label="Press Start. A 5 s countdown lets you take your hands away; the app then records for 20 minutes and stops automatically. Do not pause and resume. Start each run with cleared data." />
      <value label="Recorded time" precision="1" size="2" unit="min">
        <input>elapsedMinutes</input>
      </value>
      <value label="Time remaining" precision="0" size="1" unit="s">
        <input>remaining</input>
      </value>
      <button label="Finalise plots (after stop)">
        <input type="value">1</input>
        <output>refreshRequest</output>
      </button>
      <info label="After the automatic stop, press Finalise plots once, then export All data. This includes the last samples received since the most recent live plot update." />
      <value label="Uncalibrated / raw samples analysed" precision="0" size="1">
        <input>un</input>
      </value>
      <value label="Uncalibrated / raw measured rate" precision="2" size="1" unit="Hz">
        <input>ufs</input>
      </value>
      <value label="Calibrated samples analysed" precision="0" size="1">
        <input>cn</input>
      </value>
      <value label="Calibrated measured rate" precision="2" size="1" unit="Hz">
        <input>cfs</input>
      </value>
      <info label="Leave the experiment-menu gyroscope calibration switch unchanged: it can change both inputs together. Reopen this experiment if you accidentally change it." />
    </view>
    <view label="2. Allan X">
      <info label="ORANGE: raw / uncalibrated" color="ff8c42" />
      <info label="BLUE: calibrated" color="4da6ff" />
      <graph label="X Allan deviation" labelX="Averaging time" unitX="s" labelY="Allan deviation" unitY="deg/s" logX="true" logY="true" partialUpdate="false" aspectRatio="1.1" style="lines" lineWidth="2">
        <input axis="x">utauPlot</input>
        <input axis="y" color="ff8c42">uxAllan</input>
        <input axis="x">ctauPlot</input>
        <input axis="y" color="4da6ff">cxAllan</input>
      </graph>
      <info label="Complete non-overlapping blocks only. Points appear after at least 5 blocks. Live curves refresh about every 10 s; press Finalise plots after recording stops." />
      <value label="Raw at about 10 s" precision="6" size="1" unit="deg/s">
        <input>u08x</input>
      </value>
      <value label="Calibrated at about 10 s" precision="6" size="1" unit="deg/s">
        <input>c08x</input>
      </value>
      <value label="Raw at about 15 s" precision="6" size="1" unit="deg/s">
        <input>u09x</input>
      </value>
      <value label="Calibrated at about 15 s" precision="6" size="1" unit="deg/s">
        <input>c09x</input>
      </value>
      <value label="Raw at about 20 s" precision="6" size="1" unit="deg/s">
        <input>u10x</input>
      </value>
      <value label="Calibrated at about 20 s" precision="6" size="1" unit="deg/s">
        <input>c10x</input>
      </value>
      <button label="Finalise plots (after stop)">
        <input type="value">1</input>
        <output>refreshRequest</output>
      </button>
    </view>
    <view label="3. Allan Y">
      <info label="ORANGE: raw / uncalibrated" color="ff8c42" />
      <info label="BLUE: calibrated" color="4da6ff" />
      <graph label="Y Allan deviation" labelX="Averaging time" unitX="s" labelY="Allan deviation" unitY="deg/s" logX="true" logY="true" partialUpdate="false" aspectRatio="1.1" style="lines" lineWidth="2">
        <input axis="x">utauPlot</input>
        <input axis="y" color="ff8c42">uyAllan</input>
        <input axis="x">ctauPlot</input>
        <input axis="y" color="4da6ff">cyAllan</input>
      </graph>
      <info label="Complete non-overlapping blocks only. Points appear after at least 5 blocks. Live curves refresh about every 10 s; press Finalise plots after recording stops." />
      <value label="Raw at about 10 s" precision="6" size="1" unit="deg/s">
        <input>u08y</input>
      </value>
      <value label="Calibrated at about 10 s" precision="6" size="1" unit="deg/s">
        <input>c08y</input>
      </value>
      <value label="Raw at about 15 s" precision="6" size="1" unit="deg/s">
        <input>u09y</input>
      </value>
      <value label="Calibrated at about 15 s" precision="6" size="1" unit="deg/s">
        <input>c09y</input>
      </value>
      <value label="Raw at about 20 s" precision="6" size="1" unit="deg/s">
        <input>u10y</input>
      </value>
      <value label="Calibrated at about 20 s" precision="6" size="1" unit="deg/s">
        <input>c10y</input>
      </value>
      <button label="Finalise plots (after stop)">
        <input type="value">1</input>
        <output>refreshRequest</output>
      </button>
    </view>
    <view label="4. Allan Z">
      <info label="ORANGE: raw / uncalibrated" color="ff8c42" />
      <info label="BLUE: calibrated" color="4da6ff" />
      <graph label="Z Allan deviation" labelX="Averaging time" unitX="s" labelY="Allan deviation" unitY="deg/s" logX="true" logY="true" partialUpdate="false" aspectRatio="1.1" style="lines" lineWidth="2">
        <input axis="x">utauPlot</input>
        <input axis="y" color="ff8c42">uzAllan</input>
        <input axis="x">ctauPlot</input>
        <input axis="y" color="4da6ff">czAllan</input>
      </graph>
      <info label="Complete non-overlapping blocks only. Points appear after at least 5 blocks. Live curves refresh about every 10 s; press Finalise plots after recording stops." />
      <value label="Raw at about 10 s" precision="6" size="1" unit="deg/s">
        <input>u08z</input>
      </value>
      <value label="Calibrated at about 10 s" precision="6" size="1" unit="deg/s">
        <input>c08z</input>
      </value>
      <value label="Raw at about 15 s" precision="6" size="1" unit="deg/s">
        <input>u09z</input>
      </value>
      <value label="Calibrated at about 15 s" precision="6" size="1" unit="deg/s">
        <input>c09z</input>
      </value>
      <value label="Raw at about 20 s" precision="6" size="1" unit="deg/s">
        <input>u10z</input>
      </value>
      <value label="Calibrated at about 20 s" precision="6" size="1" unit="deg/s">
        <input>c10z</input>
      </value>
      <button label="Finalise plots (after stop)">
        <input type="value">1</input>
        <output>refreshRequest</output>
      </button>
    </view>
    <view label="5. Rate traces">
      <info label="Approximately 1 s means for viewing only. ORANGE raw; BLUE calibrated. Both full-rate source streams are preserved in the export." />
      <graph label="X rate" labelX="Time" unitX="s" labelY="Rotation rate" unitY="deg/s" timeOnX="true" partialUpdate="false">
        <input axis="x">uplotTx</input>
        <input axis="y" color="ff8c42">uplotx</input>
        <input axis="x">cplotTx</input>
        <input axis="y" color="4da6ff">cplotx</input>
      </graph>
      <graph label="Y rate" labelX="Time" unitX="s" labelY="Rotation rate" unitY="deg/s" timeOnX="true" partialUpdate="false">
        <input axis="x">uplotTy</input>
        <input axis="y" color="ff8c42">uploty</input>
        <input axis="x">cplotTy</input>
        <input axis="y" color="4da6ff">cploty</input>
      </graph>
      <graph label="Z rate" labelX="Time" unitX="s" labelY="Rotation rate" unitY="deg/s" timeOnX="true" partialUpdate="false">
        <input axis="x">uplotTz</input>
        <input axis="y" color="ff8c42">uplotz</input>
        <input axis="x">cplotTz</input>
        <input axis="y" color="4da6ff">cplotz</input>
      </graph>
    </view>
    <view label="6. Method">
      <info label="Each stream uses its own timestamps and measured sampling rate. For target tau, m = round(tau * sampling rate). The graph uses the resulting actual tau = m / sampling rate." />
      <info label="With K complete blocks and block means b, Allan deviation = sqrt[sum((b_next - b)^2) / (2*(K-1))]. It is reported in deg/s. No detrending or subtraction of a fitted drift is applied." />
      <info label="At tau near 120 s, a 20 min recording provides only about 10 blocks, so the right-hand end is less well determined. Block and difference counts are exported; these are not independent degrees of freedom." />
      <info label="This sample-based estimate assumes approximately uniform sampling. A long gap or a paused run needs separate treatment. Both native timestamp columns and the largest observed sample gap are exported." />
      <info label="A lower calibrated curve shows lower fluctuations in that stream. It does not demonstrate that the steady Earth-rotation signal survives calibration. Use the separate ABBA experiment for that comparison." />
      <value label="Raw time span analysed" precision="2" size="1" unit="s">
        <input>uspan</input>
      </value>
      <value label="Raw largest sample gap" precision="4" size="1" unit="s">
        <input>umaxGap</input>
      </value>
      <value label="Raw sample-interval SD" precision="5" size="1" unit="s">
        <input>udtSD</input>
      </value>
      <value label="Calibrated time span analysed" precision="2" size="1" unit="s">
        <input>cspan</input>
      </value>
      <value label="Calibrated largest sample gap" precision="4" size="1" unit="s">
        <input>cmaxGap</input>
      </value>
      <value label="Calibrated sample-interval SD" precision="5" size="1" unit="s">
        <input>cdtSD</input>
      </value>
    </view>
  </views>
  <analysis sleep="10" timedRun="true" timedRunStartDelay="5" timedRunStopDelay="1200">
    <timer>
      <output>now</output>
    </timer>
    <formula formula="min([1],[2])/60">
