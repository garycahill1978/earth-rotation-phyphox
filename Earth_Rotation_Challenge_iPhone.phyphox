<?xml version='1.0' encoding='utf-8'?>
<phyphox version="1.19" locale="en">
  <title>Earth Rotation Challenge - iPhone Beta</title>
  <category>Gyroscope</category>
  <description>Concurrent raw and calibrated iPhone gyroscope recording for an ABBA reversal. Requires the iOS beta supporting preferUncalibrated. The two streams keep their own timestamps and use identical measurement windows. Default: 15 s per block, 5 s settling, 7 s to turn; result at about 89 s. All displays use degrees per second. Full native rad/s data are also exported. Leave the experiment-menu gyroscope calibration switch unchanged: it can change both inputs together.</description>
  <data-containers>
    <container size="0">ux</container>
    <container size="0">uy</container>
    <container size="0">uz</container>
    <container size="0">ut</container>
    <container size="1" init="5">settleTime</container>
    <container size="1" init="7">turnTime</container>
    <container size="1" init="15">measureTime</container>
    <container size="1" init="180">qualityTime</container>
    <container size="1" init="53.4">latitude</container>
    <container size="1">now</container>
    <container size="1">expected</container>
    <container size="1">A1s</container>
    <container size="1">A1e</container>
    <container size="1">rot1End</container>
    <container size="1">B1s</container>
