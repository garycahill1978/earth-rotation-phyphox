    <view label="6. Optional stability">
      <info label="After ABBA, keep the iPhone untouched for 180 s. This retains the original approximate 15 s, non-overlapping Allan-deviation check for both streams. Pause at ABBA completion if you only want the reversal measurement." />
      <value label="Quality data collected" precision="0" size="1" unit="s / 180 s">
        <input>qualityElapsed</input>
      </value>
      <separator height="0.6" />
      <info label="RAW" />
      <value label="Y Allan deviation at about 15 s" precision="6" size="1" unit="deg/s">
        <input>allanY15</input>
      </value>
      <value label="X Allan deviation at about 15 s" precision="6" size="1" unit="deg/s">
        <input>allanX15</input>
      </value>
      <value label="Observed sampling rate" precision="2" size="1" unit="Hz">
        <input>fs</input>
      </value>
      <separator height="0.6" />
      <info label="CALIBRATED" />
      <value label="Y Allan deviation at about 15 s" precision="6" size="1" unit="deg/s">
        <input>c_allanY15</input>
      </value>
      <value label="X Allan deviation at about 15 s" precision="6" size="1" unit="deg/s">
        <input>c_allanX15</input>
      </value>
      <value label="Observed sampling rate" precision="2" size="1" unit="Hz">
        <input>c_fs</input>
      </value>
      <info label="A stability check screens noise and drift. It does not establish Earth rotation, and bias correction can suppress a steady signal. Use the repeated reversal results for the comparison." />
    </view>
