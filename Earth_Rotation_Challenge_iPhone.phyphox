  </data-containers>
  <input>
    <sensor type="gyroscope" rate="100" rateStrategy="request" preferUncalibrated="true">
      <output component="x">ux</output>
      <output component="y">uy</output>
      <output component="z">uz</output>
      <output component="t">ut</output>
    </sensor>
    <sensor type="gyroscope" rate="100" rateStrategy="request" preferUncalibrated="false">
      <output component="x">c_ux</output>
      <output component="y">c_uy</output>
      <output component="z">c_uz</output>
      <output component="t">c_ut</output>
    </sensor>
  </input>
  <views>
    <view label="1. ABBA">
      <info label="Place the iPhone flat, screen up, with its TOP (+Y) pointing TRUE NORTH. A is +Y north; B is +Y south. Rotate in the plane of the table." />
      <info label="Set the values before Start. Keep the recording running through A1, B1, B2, A2. There is NO TURN between B1 and B2. Use a fresh cleared recording for each sequence." />
      <edit label="Average each block" default="15" min="2" max="60" unit="s">
        <output>measureTime</output>
      </edit>
      <edit label="Settling after placement/turn" default="5" min="1" max="30" unit="s">
        <output>settleTime</output>
      </edit>
      <edit label="Time allowed to turn" default="7" min="2" max="30" unit="s">
        <output>turnTime</output>
      </edit>
      <edit label="Latitude" default="53.4" min="-89" max="89" unit="deg">
        <output>latitude</output>
      </edit>
      <value label="CURRENT INSTRUCTION" size="2">
        <input>stage</input>
        <map min="0" max="0">SETTLE: +Y NORTH - HANDS OFF</map>
        <map min="1" max="1">MEASURE A1: +Y NORTH - DO NOT TOUCH</map>
        <map min="2" max="2">ROTATE IPHONE GENTLY THROUGH 180 DEGREES</map>
        <map min="3" max="3">SETTLE: +Y NOW SOUTH - HANDS OFF</map>
        <map min="4" max="4">MEASURE B1: STAY COMPLETELY STILL</map>
        <map min="5" max="5">MEASURE B2: STAY COMPLETELY STILL</map>
        <map min="6" max="6">ROTATE IPHONE GENTLY BACK 180 DEGREES</map>
        <map min="7" max="7">SETTLE: +Y NORTH AGAIN - HANDS OFF</map>
        <map min="8" max="8">MEASURE A2: +Y NORTH - DO NOT TOUCH</map>
        <map min="9" max="9">ABBA COMPLETE - PAUSE AND EXPORT, OR KEEP STILL FOR OPTIONAL QUALITY CHECK</map>
        <map min="10" max="10">ABBA AND QUALITY CHECK COMPLETE - PAUSE AND EXPORT</map>
      </value>
      <value label="Elapsed" precision="1" size="1" unit="s">
        <input>now</input>
      </value>
      <value label="ABBA finished at" precision="1" size="1" unit="s">
        <input>abbaEnd</input>
      </value>
      <separator height="0.6" />
      <value label="RAW Y reversal" precision="6" size="2" unit="deg/s">
        <input>dY</input>
      </value>
      <value label="CALIBRATED Y reversal" precision="6" size="2" unit="deg/s">
        <input>c_dY</input>
      </value>
      <value label="Expected reversal: 2 Omega cos(latitude)" precision="6" size="1" unit="deg/s">
        <input>expected</input>
      </value>
      <info label="Both streams are recorded together at a requested 100 Hz. Their actual sampling times can differ; the ABBA windows are identical." />
      <info label="Leave the gyroscope calibration switch in the experiment menu unchanged: it can switch BOTH inputs to the same mode. Reopen the experiment if you change it." />
    </view>
    <view label="2. Results">
      <value label="Sequence" precision="0" size="2">
        <input>complete</input>
        <map min="0" max="0">WAIT FOR COMPLETE ABBA</map>
        <map min="1" max="1">ABBA COMPLETE</map>
      </value>
      <info label="Reversal D = (A1 + A2 - B1 - B2)/2. The horizontal Earth-rate estimate is D/2. Positive Y is expected for the stated north-first orientation." />
      <separator height="0.6" />
      <info label="RAW" />
      <value label="Y reversal D" precision="6" size="2" unit="deg/s">
        <input>dY</input>
      </value>
      <value label="Horizontal rate D/2" precision="6" size="2" unit="deg/s">
        <input>omegaH</input>
      </value>
      <value label="X control reversal" precision="6" size="1" unit="deg/s">
        <input>dX</input>
      </value>
      <value label="Z control reversal" precision="6" size="1" unit="deg/s">
        <input>dZ</input>
      </value>
      <value label="Difference from expected reversal" precision="1" size="1" unit="%">
        <input>percentError</input>
      </value>
      <separator height="0.6" />
      <info label="CALIBRATED" />
      <value label="Y reversal D" precision="6" size="2" unit="deg/s">
        <input>c_dY</input>
      </value>
      <value label="Horizontal rate D/2" precision="6" size="2" unit="deg/s">
        <input>c_omegaH</input>
      </value>
      <value label="X control reversal" precision="6" size="1" unit="deg/s">
        <input>c_dX</input>
      </value>
      <value label="Z control reversal" precision="6" size="1" unit="deg/s">
        <input>c_dZ</input>
      </value>
      <value label="Difference from expected reversal" precision="1" size="1" unit="%">
        <input>c_percentError</input>
      </value>
      <separator height="0.6" />
      <value label="Expected horizontal rate" precision="6" size="1" unit="deg/s">
        <input>expectedH</input>
      </value>
      <value label="Raw D minus calibrated D" precision="6" size="1" unit="deg/s">
        <input>deltaDifference</input>
      </value>
      <info label="The last value compares the same four time windows. It is not a sample-by-sample hardware bias measurement. A small calibrated result alone does not show that the raw result is Earth rotation." />
      <info label="Export All data after each run. Raw gyro and Calibrated gyro have independent time columns; match them by time, not row number. Summary includes both results; Block statistics includes means, SDs, counts and mean sample times." />
    </view>
    <view label="3. Raw graphs">
      <info label="Full-rate X, Y and Z in deg/s. Large turn spikes are retained; zoom the stationary intervals to inspect small rates. The vertical range follows the recorded data." />
      <graph label="X gyroscope" labelX="Time" labelY="Rate" unitX="s" unitY="deg/s" timeOnX="true" partialUpdate="false">
        <input axis="x">ut</input>
        <input axis="y">ux_deg</input>
      </graph>
      <graph label="Y gyroscope" labelX="Time" labelY="Rate" unitX="s" unitY="deg/s" timeOnX="true" partialUpdate="false">
        <input axis="x">ut</input>
        <input axis="y">uy_deg</input>
      </graph>
      <graph label="Z gyroscope" labelX="Time" labelY="Rate" unitX="s" unitY="deg/s" timeOnX="true" partialUpdate="false">
        <input axis="x">ut</input>
        <input axis="y">uz_deg</input>
      </graph>
    </view>
    <view label="4. Calibrated graphs">
      <info label="Full-rate X, Y and Z in deg/s. Large turn spikes are retained; zoom the stationary intervals to inspect small rates. The vertical range follows the recorded data." />
      <graph label="X gyroscope" labelX="Time" labelY="Rate" unitX="s" unitY="deg/s" timeOnX="true" partialUpdate="false">
        <input axis="x">c_ut</input>
        <input axis="y">c_ux_deg</input>
      </graph>
      <graph label="Y gyroscope" labelX="Time" labelY="Rate" unitX="s" unitY="deg/s" timeOnX="true" partialUpdate="false">
        <input axis="x">c_ut</input>
        <input axis="y">c_uy_deg</input>
      </graph>
      <graph label="Z gyroscope" labelX="Time" labelY="Rate" unitX="s" unitY="deg/s" timeOnX="true" partialUpdate="false">
        <input axis="x">c_ut</input>
        <input axis="y">c_uz_deg</input>
      </graph>
    </view>
    <view label="5. Block statistics">
      <info label="Y-axis sample mean and sample SD for each retained measurement window. SD describes sample scatter; it is not an uncertainty on the ABBA result. All X/Y/Z statistics are included in the export." />
      <separator height="0.6" />
      <info label="A1" />
      <value label="Raw Y mean" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>muy_A1</input>
      </value>
      <value label="Raw Y SD" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>sduy_A1</input>
      </value>
      <value label="Raw samples" precision="0" size="1">
        <input>n_A1</input>
      </value>
      <value label="Calibrated Y mean" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>c_muy_A1</input>
      </value>
      <value label="Calibrated Y SD" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>c_sduy_A1</input>
      </value>
      <value label="Calibrated samples" precision="0" size="1">
        <input>c_n_A1</input>
      </value>
      <separator height="0.6" />
      <info label="B1" />
      <value label="Raw Y mean" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>muy_B1</input>
      </value>
      <value label="Raw Y SD" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>sduy_B1</input>
      </value>
      <value label="Raw samples" precision="0" size="1">
        <input>n_B1</input>
      </value>
      <value label="Calibrated Y mean" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>c_muy_B1</input>
      </value>
      <value label="Calibrated Y SD" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>c_sduy_B1</input>
      </value>
      <value label="Calibrated samples" precision="0" size="1">
        <input>c_n_B1</input>
      </value>
      <separator height="0.6" />
      <info label="B2" />
      <value label="Raw Y mean" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>muy_B2</input>
      </value>
      <value label="Raw Y SD" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>sduy_B2</input>
      </value>
      <value label="Raw samples" precision="0" size="1">
        <input>n_B2</input>
      </value>
      <value label="Calibrated Y mean" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>c_muy_B2</input>
      </value>
      <value label="Calibrated Y SD" precision="6" size="1" unit="deg/s" factor="57.29577951308232">
        <input>c_sduy_B2</input>
