<data name="Earth-Allan ratio 30 s">r30</data>

  <data name="Allan minimum (deg/s)">allan_min</data>
  <data name="Allan-minimum tau (s)">allan_min_tau</data>
  <data name="Best Earth-Allan ratio">best_ratio</data>
